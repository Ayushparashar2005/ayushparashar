---
interface Props {
  projectId: string;
  className?: string;
}

const { projectId, className = "" } = Astro.props;
---

<d3-oscilloscope class={`absolute bottom-0 left-0 w-full h-16 pointer-events-none ${className}`} data-project-id={projectId}></d3-oscilloscope>

<script>
  import * as d3 from 'd3';

  class Oscilloscope extends HTMLElement {
    private svg: any;
    private path1: any;
    private path2: any;
    private projectId: string;
    
    // State controlled by knobs
    private amplitude = 0.5; // 0 to 1, maps to height
    private frequency = 0.5; // 0 to 1, maps to speed/density
    
    private time = 0;
    private animationFrameId: number = 0;

    constructor() {
      super();
      this.projectId = this.dataset.projectId || '';
      
      this.handleKnobChange = this.handleKnobChange.bind(this);
      this.updateFrame = this.updateFrame.bind(this);
    }

    connectedCallback() {
      // Setup D3 SVG
      this.svg = d3.select(this as HTMLElement)
        .append('svg')
        .attr('preserveAspectRatio', 'none')
        .attr('viewBox', '0 0 100 100')
        .attr('width', '100%')
        .attr('height', '100%')
        .classed('stroke-hw-accent-orange opacity-40', true); // higher opacity now that it's dynamic
        
      this.path1 = this.svg.append('path')
        .attr('fill', 'none')
        .attr('stroke-width', '3');
        
      this.path2 = this.svg.append('path')
        .attr('fill', 'none')
        .attr('stroke-width', '2')
        .attr('opacity', '0.5');

      // Listen for global knob changes
      document.addEventListener('synth-knob-change', this.handleKnobChange as EventListener);
      
      this.updateFrame();
    }
    
    disconnectedCallback() {
      document.removeEventListener('synth-knob-change', this.handleKnobChange as EventListener);
      cancelAnimationFrame(this.animationFrameId);
    }

    private handleKnobChange(e: CustomEvent) {
      if (e.detail.projectId !== this.projectId) return;
      
      if (e.detail.id === 'vol') {
        this.amplitude = e.detail.value;
      } else if (e.detail.id === 'freq') {
        this.frequency = e.detail.value;
      }
    }

    private updateFrame() {
      // Base speed + freq multiplier
      this.time += 0.5 + (this.frequency * 3); 
      
      // Calculate path based on amplitude and frequency
      // Math: y = 50 + sin(x/scale + time) * height
      const points1 = [];
      const points2 = [];
      
      const width = 100;
      const centerY = 50;
      const height1 = (this.amplitude * 40) + 5; // 5 to 45
      const height2 = (this.amplitude * 30) + 2;
      
      // More waves based on freq
      const waveScale = 15 - (this.frequency * 10); 
      
      for (let x = 0; x <= width; x += 5) {
        const y1 = centerY + Math.sin((x / waveScale) + (this.time * 0.05)) * height1;
        points1.push([x, y1]);
        
        // Path 2 moves slightly differently
        const y2 = centerY + Math.sin((x / waveScale) + (this.time * 0.03) + Math.PI) * height2;
        points2.push([x, y2]);
      }
      
      const lineGenerator = d3.line().curve(d3.curveBasis);
      
      this.path1.attr('d', lineGenerator(points1 as [number, number][]));
      this.path2.attr('d', lineGenerator(points2 as [number, number][]));
      
      this.animationFrameId = requestAnimationFrame(this.updateFrame);
    }
  }

  if (!customElements.get('d3-oscilloscope')) {
    customElements.define('d3-oscilloscope', Oscilloscope);
  }
</script>
