---
interface Props {
  status: 'active' | 'inactive' | 'error' | 'warning';
  size?: 'sm' | 'md' | 'lg';
}

const { status, size = 'md' } = Astro.props;

const statusColors = {
  active: 'bg-hw-accent-blue shadow-[0_0_8px_rgba(0,91,196,0.6)]',
  inactive: 'bg-zinc-700 shadow-none',
  error: 'bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.6)]',
  warning: 'bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]'
};

const sizeClasses = {
  sm: 'w-1.5 h-1.5',
  md: 'w-2 h-2',
  lg: 'w-3 h-3'
};
---

<div class={`rounded-full ${sizeClasses[size]} ${statusColors[status]}`}></div>
