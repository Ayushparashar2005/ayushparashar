---
import BaseLayout from '../layouts/BaseLayout.astro';
import SynthShell from '../components/common/SynthShell.astro';
import ModulePanel from '../components/synth/ModulePanel.astro';
import { db } from '../db';
import { skills, experience, certifications } from '../db/schema';
import { asc } from 'drizzle-orm';

const allSkills = await db.select().from(skills).orderBy(asc(skills.proficiency));
const myExperience = await db.select().from(experience).orderBy(asc(experience.displayOrder));
const allCerts = await db.select().from(certifications).orderBy(asc(certifications.displayOrder));
---

<BaseLayout title="ayush.wav | SKILLS & CERTS">
  <SynthShell activePreset="skills">
    <div class="w-full h-full flex flex-col md:flex-row gap-4 p-4 overflow-y-auto custom-scrollbar md:overflow-hidden">
      
      <!-- Skills Matrix -->
      <ModulePanel title="TAPE // SKILLS_MATRIX" className="w-full md:w-1/2 h-[450px] md:h-full md:max-h-[800px] shrink-0 min-h-0">
         <div class="flex flex-col gap-4 h-full p-4 overflow-hidden min-h-0">
            <!-- Hardware Toggles -->
            <div class="flex gap-2 md:gap-4 mb-2 shrink-0 bg-hw-module-inset p-2 rounded border-2 border-hw-border shadow-inner" id="skill-tabs">
               <button class="text-[9px] sm:text-xs px-2 md:px-8 py-2.5 flex-1 min-w-0 tracking-widest font-bold rounded shadow-sm border border-hw-accent-orange transition-all bg-[#2a1100] text-hw-accent-orange flex items-center justify-center gap-1 sm:gap-3 relative overflow-hidden" data-tab="Languages">
                  <div class="w-1.5 h-1.5 rounded-full bg-hw-accent-orange shadow-[0_0_8px_rgba(255,85,0,0.9)] pointer-events-none indicator-led shrink-0"></div>
                  <span class="pointer-events-none relative z-10 truncate">LANGUAGES</span>
                  <!-- Inner highlight -->
                  <div class="absolute inset-0 shadow-[inset_0_2px_4px_rgba(255,255,255,0.1)] pointer-events-none"></div>
               </button>
               <button class="text-[9px] sm:text-xs px-2 md:px-8 py-2.5 flex-1 min-w-0 tracking-widest font-bold rounded shadow-sm border border-hw-screw-border transition-all bg-hw-module text-hw-text-muted hover:bg-hw-sticker flex items-center justify-center gap-1 sm:gap-3 relative overflow-hidden" data-tab="Technologies">
                  <div class="w-1.5 h-1.5 rounded-full bg-hw-screw shadow-inner pointer-events-none indicator-led"></div>
                  <span class="pointer-events-none relative z-10">FRAMEWORKS</span>
               </button>
            </div>
            
            <div class="flex flex-col gap-3 h-full overflow-y-auto pr-2 custom-scrollbar min-h-0" id="skills-list">
               {allSkills.map((skill: any) => (
                  <div class="skill-item bg-hw-sticker border-2 border-hw-border px-3 py-2 rounded flex items-center justify-between gap-3 shadow-sm relative shrink-0" data-category={skill.category}>
                     <!-- Screws -->
                     <div class="absolute top-1 left-1 w-1 h-1 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                     <div class="absolute bottom-1 right-1 w-1 h-1 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                     
                     <span class="text-[10px] md:text-xs font-bold font-sans text-hw-text-main w-20 md:w-24 shrink-0 z-10 pl-1">{skill.name.toUpperCase()}</span>
                     
                     <div class="flex-grow h-3.5 bg-hw-screen-light relative rounded overflow-hidden shadow-[inset_0_1px_5px_rgba(0,0,0,0.8)] border border-hw-border-screen z-10 flex items-center">
                       <!-- SVG Black Slits to separate LEDs -->
                       <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjIwIj48cGF0aCBkPSJNMCAwaDF2MjBIMHoiIGZpbGw9IiMxYTFhMWEiLz48L3N2Zz4=')] z-20"></div>
                       
                       <!-- LED Fill -->
                       <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-[#0066ff] via-[#00aaff] to-[#00ffee] z-10 shadow-[0_0_8px_rgba(0,170,255,0.6)]" style={`width: ${skill.proficiency}%`}></div>
                     </div>
                     <div class="bg-hw-screen border border-hw-border-screen px-1 py-0.5 rounded shadow-inner z-10 min-w-[28px] flex justify-center">
                       <span class="text-[8px] md:text-[10px] font-mono font-bold text-[#00ffee] text-center shrink-0 block tracking-widest">{skill.proficiency}</span>
                     </div>
                  </div>
               ))}
            </div>
         </div>
      </ModulePanel>

      <!-- Certifications -->
      <ModulePanel title="MEM // CERTIFICATIONS" className="w-full md:w-1/2 h-[450px] md:h-full md:max-h-[800px] shrink-0 min-h-0">
         <div class="flex flex-col h-full p-4 overflow-hidden min-h-0">
            <div class="text-xs font-sans font-bold text-hw-text-muted tracking-[0.2em] uppercase border-b-2 border-hw-border pb-3 mb-6 shrink-0 flex items-center gap-3">
              <div class="w-2 h-2 rounded-full bg-hw-text-muted"></div>
              DATA BANKS
            </div>
            <div class="flex flex-col gap-3 h-full overflow-y-auto pr-2 custom-scrollbar min-h-0">
               {allCerts.map((cert: any) => (
                  <div class="bg-hw-module-inset border-2 border-hw-border p-2 rounded-lg flex flex-col shadow-inner shrink-0 relative group hover:bg-hw-module transition-colors cursor-default">
                     <div class="bg-hw-sticker border border-hw-border rounded p-3 flex flex-col shadow-sm relative overflow-hidden">
                       <div class="absolute top-0 right-0 bottom-0 w-6 bg-hw-sticker border-l border-hw-border flex items-center justify-center pointer-events-none z-10">
                         <div class="w-full h-full bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjEwMCI+PHBhdGggZD0iTTAgMGgxdjEwMEgwek0yIDBoMXYxMDBIMnpNNCAwaDJ2MTAwSDR6TTcgMGgxdjEwMEg3eiIgZmlsbD0iIzIyMiIvPjwvc3ZnPg==')] opacity-30"></div>
                       </div>
                       
                       <div class="absolute top-0 left-0 bg-hw-screen text-hw-accent-orange text-[7px] font-mono font-bold px-1.5 py-0.5 rounded-br uppercase tracking-widest z-10">READ_ONLY</div>
                       
                       <span class="text-[11px] md:text-sm font-mono font-bold text-hw-text-main leading-tight pr-8 tracking-wide z-10 mt-3">{cert.title.toUpperCase()}</span>
                       <div class="flex justify-between items-end mt-1 pt-2 border-t border-hw-border border-dashed pr-8 z-10">
                          <span class="text-[8px] font-mono text-hw-text-muted uppercase tracking-widest truncate max-w-[100px] sm:max-w-[160px] md:max-w-full">{cert.issuer}</span>
                          <span class="text-[8px] font-mono font-bold text-hw-accent-orange bg-black border border-hw-border px-1 shadow-inner shrink-0">[{cert.date}]</span>
                       </div>
                     </div>
                  </div>
               ))}
            </div>
         </div>
      </ModulePanel>

    </div>
  </SynthShell>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('#skill-tabs button');
    const items = document.querySelectorAll('.skill-item');

    const filterSkills = (category: string) => {
      items.forEach(item => {
        if ((item as HTMLElement).dataset.category === category) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    };

    filterSkills('Languages');

    tabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = (e.currentTarget as HTMLElement);
        
        // Reset all tabs to inactive state
        tabs.forEach(t => {
           t.classList.remove('border-hw-accent-orange', 'bg-[#2a1100]', 'text-hw-accent-orange', 'shadow-[inset_0_0_8px_rgba(255,85,0,0.3)]');
           t.classList.add('border-hw-screw-border', 'bg-hw-module', 'text-hw-text-muted', 'hover:bg-hw-sticker');
           
           const led = t.querySelector('.indicator-led');
           if(led) {
             led.classList.remove('bg-hw-accent-orange', 'shadow-[0_0_8px_rgba(255,85,0,0.9)]');
             led.classList.add('bg-hw-screw', 'shadow-inner');
           }
        });
        
        // Set clicked tab to active state
        target.classList.remove('border-hw-screw-border', 'bg-hw-module', 'text-hw-text-muted', 'hover:bg-hw-sticker');
        target.classList.add('border-hw-accent-orange', 'bg-[#2a1100]', 'text-hw-accent-orange', 'shadow-[inset_0_0_8px_rgba(255,85,0,0.3)]');
        
        const activeLed = target.querySelector('.indicator-led');
        if(activeLed) {
           activeLed.classList.remove('bg-hw-screw', 'shadow-inner');
           activeLed.classList.add('bg-hw-accent-orange', 'shadow-[0_0_8px_rgba(255,85,0,0.9)]');
        }
        
        filterSkills(target.dataset.tab || 'Languages');
      });
    });
  });
</script>
