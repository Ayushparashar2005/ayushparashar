---
import PatchBayLayout from '../../layouts/PatchBayLayout.astro';
import { db } from '../../db';
import { experience } from '../../db/schema';
import { asc } from 'drizzle-orm';
import ExperienceManager from '../../islands/patch-bay/ExperienceManager';

const allExperience = await db.select().from(experience).orderBy(asc(experience.displayOrder));
---

<PatchBayLayout title="EXPERIENCE">
  <ExperienceManager client:load initialExperience={allExperience} />
</PatchBayLayout>
