---
import PatchBayLayout from '../../layouts/PatchBayLayout.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

const dataPath = path.join(process.cwd(), 'src/data/identity.json');

// Read existing data
let identity = { name: "Ayush Parashar", role: "Engineering Student", location: "Bahadurgarh, IN", bio: "" };
try {
  const content = await fs.readFile(dataPath, 'utf-8');
  identity = JSON.parse(content);
} catch (e) {
  // Ignore, use default
}

let success = false;

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    identity = {
      name: data.get("name")?.toString() || "",
      role: data.get("role")?.toString() || "",
      location: data.get("location")?.toString() || "",
      bio: data.get("bio")?.toString() || "",
      resumeFile: identity.resumeFile || "Ayush_Parashar_Resume.pdf",
    };
    
    const resumeFile = data.get("resume");
    if (resumeFile && typeof resumeFile === 'object' && 'arrayBuffer' in resumeFile && resumeFile.size > 0) {
      const originalName = (resumeFile as File).name || "Ayush_Parashar_Resume.pdf";
      const buffer = await resumeFile.arrayBuffer();
      const resumePath = path.join(process.cwd(), 'public', originalName);
      await fs.writeFile(resumePath, Buffer.from(buffer));
      identity.resumeFile = originalName;
    }
    
    await fs.mkdir(path.dirname(dataPath), { recursive: true });
    await fs.writeFile(dataPath, JSON.stringify(identity, null, 2));
    success = true;
  } catch (error) {
    console.error(error);
  }
}
---

<PatchBayLayout title="SETTINGS">
  <div class="flex flex-col gap-6 w-full">
    <p class="text-hw-text-muted font-mono text-sm mb-4">Configure your portfolio identity settings.</p>

    <form method="POST" enctype="multipart/form-data" class="bg-hw-sticker border border-hw-border p-6 rounded-md flex flex-col gap-4 shadow-sm w-full">
      <h3 class="text-hw-text-main font-mono font-bold border-b border-hw-border pb-2">PROFILE SETTINGS (IDENTITY)</h3>
      
      {success && <div class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 border border-green-300 dark:border-green-800 p-2 text-xs font-mono rounded">Saved successfully!</div>}

      <div class="flex flex-col gap-2">
        <label class="text-hw-text-muted font-mono text-xs">DISPLAY NAME</label>
        <input name="name" type="text" value={identity.name} class="bg-hw-module border border-hw-border rounded px-3 py-2 text-hw-text-main font-mono text-sm focus:outline-none focus:border-hw-accent-orange" />
      </div>

      <div class="flex flex-col gap-2 mt-2">
        <label class="text-hw-text-muted font-mono text-xs">ROLE</label>
        <input name="role" type="text" value={identity.role} class="bg-hw-module border border-hw-border rounded px-3 py-2 text-hw-text-main font-mono text-sm focus:outline-none focus:border-hw-accent-orange" />
      </div>

      <div class="flex flex-col gap-2 mt-2">
        <label class="text-hw-text-muted font-mono text-xs">LOCATION</label>
        <input name="location" type="text" value={identity.location} class="bg-hw-module border border-hw-border rounded px-3 py-2 text-hw-text-main font-mono text-sm focus:outline-none focus:border-hw-accent-orange" />
      </div>

      <div class="flex flex-col gap-2 mt-2">
        <label class="text-hw-text-muted font-mono text-xs">BIO (FULL)</label>
        <textarea name="bio" rows="6" class="bg-hw-module border border-hw-border rounded px-3 py-2 text-hw-text-main font-mono text-sm focus:outline-none focus:border-hw-accent-orange leading-relaxed">{identity.bio}</textarea>
      </div>

      <div class="flex flex-col gap-2 mt-4 pt-4 border-t border-hw-border">
        <label class="text-hw-text-muted font-mono text-xs">UPDATE RESUME (PDF)</label>
        <input name="resume" type="file" accept="application/pdf" class="block w-full text-sm text-hw-text-muted font-mono file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-xs file:font-mono file:bg-hw-bg file:border file:border-hw-border file:text-hw-text-main hover:file:bg-hw-module cursor-pointer transition-colors" />
        <p class="text-hw-text-muted opacity-70 font-mono text-[10px]">Leave empty if you don't want to update the resume.</p>
      </div>

      <div class="mt-4">
        <button type="submit" class="hw-button inline-flex self-start">
          SAVE CHANGES
        </button>
      </div>
    </form>
    
  </div>
</PatchBayLayout>
