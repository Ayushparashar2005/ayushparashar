---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SynthPlayground } from '../islands/synth/SynthPlayground';
import LabEngine from '../islands/lab/LabEngine';
import SynthShell from '../components/common/SynthShell.astro';
---

<BaseLayout title="ayush.wav | PERFORM">
  <div class="w-full h-screen flex flex-col bg-hw-bg relative overflow-hidden text-hw-text-main">
    
    <!-- Top Navigation (Quick Exit to home) -->
    <div class="absolute top-4 left-4 z-50">
      <a href="/" class="flex items-center gap-2 px-3 py-2 bg-black text-white font-mono text-xs font-bold border-2 border-hw-border rounded-sm hover:bg-hw-accent-orange hover:border-hw-accent-orange transition-colors shadow-sm">
        <span class="text-hw-accent-orange">&lt;</span> BACK TO DESK
      </a>
    </div>

    <div class="w-full h-12 flex items-center justify-center bg-[#050505] border-b-2 border-hw-border">
      <span class="font-mono text-xs font-bold tracking-widest text-hw-accent-orange uppercase">PERFORM // AUDIOVISUAL MODE</span>
      <span class="ml-4 text-[9px] font-mono opacity-50 hidden sm:inline">SYNTH → AUDIO BRIDGE → LAB VISUALS</span>
    </div>

    <!-- Split Content Area -->
    <main class="flex-1 w-full h-full min-h-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden custom-scrollbar">
      
      <!-- Left side: Lab Engine -->
      <div class="flex-1 w-full lg:w-1/2 min-h-[400px] lg:min-h-0 h-[400px] lg:h-full shrink-0 lg:shrink border-b-2 lg:border-b-0 lg:border-r-2 border-hw-border bg-hw-module overflow-hidden relative">
        <LabEngine client:only="preact" />
      </div>

      <!-- Right side: Synth Instrument -->
      <div class="w-full lg:w-[45%] shrink-0 min-h-[600px] lg:min-h-0 h-auto lg:h-full overflow-y-auto bg-hw-panel p-4 flex flex-col justify-center">
        <SynthPlayground mode="instrument" client:only="preact" />
      </div>

    </main>

  </div>
</BaseLayout>
