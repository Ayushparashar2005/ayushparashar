---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SynthPlayground } from '../islands/synth/SynthPlayground';
---

<BaseLayout title="PLAYGROUND">
  <div class="w-full min-h-screen p-2 md:p-6 flex flex-col items-center bg-hw-bg/80 y2k-checker pt-16 lg:pt-24 relative overflow-hidden">
    
    <!-- Top Navigation (Quick Exit to home) -->
    <div class="absolute top-4 left-4 z-50">
      <a href="/" class="flex items-center gap-2 px-3 py-2 bg-black text-white font-mono text-xs font-bold border-2 border-hw-border rounded-sm hover:bg-hw-accent-orange hover:border-hw-accent-orange transition-colors shadow-sm">
        <span class="text-hw-accent-orange">&lt;</span> BACK TO DESK
      </a>
    </div>

    <!-- Synth Container -->
    <main class="w-full max-w-[1200px] z-10 flex flex-col gap-8">
      
      <div class="text-center mb-4">
        <h1 class="font-sans font-black text-4xl md:text-6xl tracking-tighter text-hw-text-main dark:text-white uppercase drop-shadow-sm">
          SYNTH <span class="text-hw-accent-orange">PLAYGROUND</span>
        </h1>
        <p class="font-mono text-xs md:text-sm text-hw-text-muted mt-2 max-w-xl mx-auto">
          A fully functional Digital Audio Workstation (DAW) built from scratch using the native Web Audio API. 
          Sequence multiple tracks, edit clips in the MIDI piano roll, craft custom synth patches, and export directly to WAV. 
          Use your QWERTY keyboard (Z-M row for white keys, S-L row for black keys) to play live.
        </p>
      </div>

      <!-- The Preact Island -->
      <SynthPlayground client:only="preact" />
      
    </main>

  </div>
</BaseLayout>
