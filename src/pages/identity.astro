---
import BaseLayout from '../layouts/BaseLayout.astro';
import SynthShell from '../components/common/SynthShell.astro';
import ModulePanel from '../components/synth/ModulePanel.astro';
import SynthKnob from '../components/interactive/SynthKnob.astro';
import GenerativeArt from '../components/interactive/GenerativeArt.astro';
import { db } from '../db';
import { identity as identitySchema } from '../db/schema';
import { eq } from 'drizzle-orm';

let identity = {
  name: "Ayush Parashar",
  role: "Engineering Student",
  location: "Bahadurgarh, IN",
  bio: "A passionate engineering student from Bahadurgarh, building innovative solutions with modern technologies. Thriving at the intersection of design and development to turn ideas into impactful digital experiences. I am constantly learning and experimenting with cutting-edge tech, with a goal to work on projects that make a real difference — especially in healthcare and accessibility tech."
};

try {
  const existingRecords = await db.select().from(identitySchema).where(eq(identitySchema.id, 'main'));
  if (existingRecords.length > 0) {
    identity = {
      name: existingRecords[0].name,
      role: existingRecords[0].role,
      location: existingRecords[0].location,
      bio: existingRecords[0].bio,
    };
  }
} catch (e) {
  // Use default if not found
}
---

<BaseLayout title="ayush.wav | IDENTITY">
  <SynthShell activePreset="identity">
    <div class="w-full h-full flex flex-col items-center p-4 md:p-8 overflow-y-auto custom-scrollbar md:overflow-hidden">
      
      <ModulePanel title="OP-1 // IDENTITY" className="w-full max-w-5xl h-auto md:h-full md:max-h-[850px] shrink-0 min-h-0">
        <div class="flex flex-col md:flex-row h-full overflow-hidden divide-y-2 md:divide-y-0 md:divide-x-2 divide-hw-border min-h-0">
          
          <!-- LEFT COLUMN: Profile & Specs -->
          <div class="w-full md:w-[35%] flex flex-col p-4 md:p-6 bg-hw-bg relative h-[600px] sm:h-[500px] md:h-full shrink-0 md:shrink overflow-y-auto custom-scrollbar min-h-0">
             
             <div class="text-[10px] font-sans font-bold text-hw-text-muted tracking-[0.2em] uppercase border-b-2 border-hw-border pb-2 mb-4 flex items-center gap-2 shrink-0">
                 <div class="w-1.5 h-1.5 rounded-full bg-hw-accent-orange shadow-[0_0_3px_rgba(255,85,0,0.5)]"></div>
                 SYS_PROFILE
             </div>

             <!-- Profile Picture Container -->
             <div class="w-full aspect-square max-w-[240px] mx-auto bg-hw-module-inset border-2 border-hw-border rounded-lg p-2 shadow-inner relative group shrink-0 mb-6">
                <!-- Hardware Screws -->
                <div class="absolute top-2 left-2 w-1.5 h-1.5 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                <div class="absolute top-2 right-2 w-1.5 h-1.5 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                <div class="absolute bottom-2 left-2 w-1.5 h-1.5 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                <div class="absolute bottom-2 right-2 w-1.5 h-1.5 rounded-full bg-hw-screw shadow-inner border border-hw-screw-border"></div>
                
                <!-- HUD Brackets -->
                <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-hw-accent-orange opacity-50"></div>
                <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-hw-accent-orange opacity-50"></div>
                <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-hw-accent-orange opacity-50"></div>
                <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-hw-accent-orange opacity-50"></div>

                <div tabindex="0" class="w-full h-full rounded border-2 border-hw-border overflow-hidden filter grayscale contrast-125 group-hover:grayscale-0 focus:grayscale-0 transition-all duration-700 shadow-sm relative">
                  <!-- Scanlines -->
                  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjEiIGZpbGw9IiMwMDAiIGZpbGwtb3BhY2l0eT0iMC4xIi8+PC9zdmc+')] opacity-50 z-10 pointer-events-none mix-blend-overlay"></div>
                  <img src="/profile.jpg" alt={identity.name} class="w-full h-full object-cover relative z-0" />
                </div>
             </div>

             <!-- Specs Data Sheet -->
             <div class="flex-grow flex flex-col gap-3 min-h-0 shrink-0">
               <div class="bg-hw-sticker border border-hw-border rounded p-3 shadow-sm relative overflow-hidden text-xs font-mono flex flex-col gap-2">
                  <div class="absolute top-0 right-0 bottom-0 w-4 bg-hw-sticker border-l border-hw-border flex items-center justify-center pointer-events-none opacity-50">
                    <div class="w-full h-full bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI4IiBoZWlnaHQ9IjEwMCI+PHBhdGggZD0iTTAgMGgxdjEwMEgwek0yIDBoMXYxMDBIMnpNNCAwaDJ2MTAwSDR6TTcgMGgxdjEwMEg3eiIgZmlsbD0iIzIyMiIvPjwvc3ZnPg==')] opacity-20"></div>
                  </div>
                  
                  <div class="flex justify-between items-end border-b border-hw-border border-dashed pb-1 pr-4">
                     <span class="text-[9px] text-hw-text-muted font-bold tracking-widest">SYS.NAME</span>
                     <span class="font-bold text-hw-text-main truncate">{identity.name}</span>
                  </div>
                  <div class="flex justify-between items-end border-b border-hw-border border-dashed pb-1 pr-4">
                     <span class="text-[9px] text-hw-text-muted font-bold tracking-widest">SYS.ROLE</span>
                     <span class="font-bold text-hw-text-main truncate text-hw-accent-orange">{identity.role}</span>
                  </div>
                  <div class="flex justify-between items-end pb-1 pr-4">
                     <span class="text-[9px] text-hw-text-muted font-bold tracking-widest">SYS.LOC</span>
                     <span class="font-bold text-hw-text-main truncate">{identity.location}</span>
                  </div>
               </div>
             </div>

             <!-- Action Button -->
             <div class="mt-6 shrink-0">
                <a href="/resume" class="hw-button w-full h-14 flex items-center justify-center font-bold !bg-hw-accent-orange !text-white !border-hw-accent-orange hover:!bg-[#e64a00] transition-all text-xs tracking-widest shadow-[0_4px_0_#cc4400,0_5px_5px_rgba(0,0,0,0.3)] active:shadow-[0_0px_0_#cc4400,0_0px_0px_rgba(0,0,0,0.3)] active:translate-y-1 relative overflow-hidden group">
                  <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 pointer-events-none"></div>
                  [ DATA_EXPORT // CV ]
                </a>
             </div>
          </div>

          <!-- RIGHT COLUMN: Bio Screen & Controls -->
          <div class="w-full md:w-[65%] flex flex-col bg-hw-panel h-[600px] md:h-full shrink-0 md:shrink overflow-hidden min-h-0 relative">
             
             <!-- Bio LCD Screen -->
             <div class="flex-grow p-4 md:p-6 min-h-0 flex flex-col relative">
                <div class="text-[10px] font-sans font-bold text-hw-text-muted tracking-[0.2em] uppercase border-b-2 border-hw-border pb-2 mb-4 flex justify-between items-center shrink-0">
                    <span class="flex items-center gap-2">
                       <div class="w-1.5 h-1.5 rounded-full bg-[#00ffee] shadow-[0_0_5px_rgba(0,255,238,0.5)]"></div>
                       USER_MANIFEST
                    </span>
                    <span class="text-[8px] bg-hw-sticker border border-hw-border px-1">READ_ONLY</span>
                </div>

                <div class="flex-grow bg-hw-screen border-4 border-hw-border-screen rounded-lg relative shadow-[inset_0_0_20px_rgba(0,0,0,1)] overflow-hidden flex flex-col group min-h-0">
                   <!-- LCD Scanlines -->
                   <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjEiIGZpbGw9IiMwMDAiIGZpbGwtb3BhY2l0eT0iMC4yIi8+PC9zdmc+')] opacity-30 z-20 pointer-events-none mix-blend-overlay"></div>
                   <!-- Edge Shadow -->
                   <div class="absolute inset-0 shadow-[inset_0_0_40px_rgba(0,0,0,0.8)] z-20 pointer-events-none"></div>

                   <!-- Background Generative Art -->
                   <div class="absolute inset-0 opacity-40 mix-blend-screen z-0 filter blur-[1px]">
                     <GenerativeArt projectId="identity-page" />
                   </div>

                   <!-- Screen Content -->
                   <div class="relative z-10 flex-grow p-5 md:p-8 overflow-y-auto custom-scrollbar flex flex-col">
                      <div class="text-xs md:text-sm font-mono text-[#00ffee] leading-relaxed text-justify drop-shadow-[0_0_5px_rgba(0,255,238,0.5)] flex-grow">
                         <span class="text-[#00aaff] font-bold">> SYSTEM_BOOT... OK</span><br/>
                         <span class="text-[#00aaff] font-bold">> LOADING_MANIFEST...</span><br/><br/>
                         {identity.bio}
                         <span class="animate-pulse">_</span>
                      </div>
                   </div>
                </div>
             </div>

             <!-- Control Bank (Bottom) -->
             <div class="h-auto md:h-36 bg-hw-module-inset border-t-2 border-hw-border px-4 py-4 md:py-0 shrink-0 flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16 shadow-[inset_0_4px_10px_rgba(0,0,0,0.05)]">
                 
                 <div class="flex items-center gap-8 md:gap-12">
                   <div class="flex flex-col items-center gap-3">
                     <SynthKnob id="creativity" label="CREATIVITY" projectId="identity-page" initialValue={0.5} sizeClass="w-14 h-14 md:w-16 md:h-16" />
                   </div>
                   <div class="flex flex-col items-center gap-3">
                     <SynthKnob id="logic" label="LOGIC" projectId="identity-page" initialValue={1} sizeClass="w-14 h-14 md:w-16 md:h-16" />
                   </div>
                   <div class="flex flex-col items-center gap-3">
                     <SynthKnob id="design" label="DESIGN" projectId="identity-page" initialValue={0.5} sizeClass="w-14 h-14 md:w-16 md:h-16" />
                   </div>
                 </div>

             </div>

          </div>
          
        </div>
      </ModulePanel>
      
    </div>
  </SynthShell>
</BaseLayout>
